{
  "name": "enhanced-pomodoro",
  "version": "0.1.0",
  "description": "An enhanced Pomodoro timer for Obsidian with better logging and debugging features.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "pomodoro",
    "timer",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^5.29.0",
    "@typescript-eslint/parser": "^5.29.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.11",
    "obsidian": "^1.1.1",
    "tslib": "2.4.0",
    "typescript": "4.7.3"
  },
  "dependencies": {
    "@eslint/config-array": "^0.21.1",
    "@eslint/object-schema": "^2.1.7",
    "eslint": "^9.38.0",
    "glob": "^11.0.3",
    "rimraf": "^6.0.1"
  }
}
